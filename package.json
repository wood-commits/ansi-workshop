{
  "name": "ansi-workshop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "font:generate": "node --experimental-strip-types scripts/generate-font.ts",
    "build": "tsc -b && vite build && npm run build:mcp",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "agents": "npm run build:mcp && node build-mcp/mcp/start.js",
    "mcp": "node build-mcp/mcp/stdio.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build:mcp && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "scan:sast": "eslint . --max-warnings 0",
    "scan:dependencies": "npm audit --audit-level=low",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch@10": "11.0.1"
  }
}
