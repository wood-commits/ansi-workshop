{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build-mcp",
    "rootDir": ".",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["mcp/**/*.ts", "src/agentProtocol.ts"],
  "exclude": ["mcp/**/*.test.ts"]
}
